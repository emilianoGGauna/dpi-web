server {
    listen 8080 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ✅ 1) NO cachear el HTML principal (evita "versiones viejas" del sitio)
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
        expires -1;
        try_files $uri =404;
    }

    # (Opcional) también evita cachear el service worker si algún día lo agregas
    location = /service-worker.js {
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0";
        expires -1;
        try_files $uri =404;
    }

    # ✅ 2) Assets de Vite (normalmente viven en /assets/ y tienen hash)
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        expires 1y;
        access_log off;
    }

    # ✅ 3) Archivos estáticos sueltos (favicon, svg, etc.)
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|webp)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400";
        expires 1d;
        access_log off;
    }

    # ✅ 4) SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
